# Copy to .env and fill in. .env is gitignored; never paste keys into chat or commit them.

# --- Anthropic: one key powers both the Strands agent and Cognee's extraction ---
ANTHROPIC_API_KEY=

# --- Cognee (local, open source) ---
LLM_PROVIDER=anthropic
# Haiku keeps extraction fast (avoid Engram's visible 30-second wait); switch to Sonnet if quality suffers.
LLM_MODEL=anthropic/claude-haiku-4-5-20251001
LLM_API_KEY=${ANTHROPIC_API_KEY}
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# --- Optional: Cognee Cloud (event credits). If both are set, the app calls cognee.serve()
# and remember/recall/forget run on the cloud tenant instead of locally.
# Console → API Keys page: API Base URL looks like https://<tenant>.aws.cognee.ai
COGNEE_API_URL=
COGNEE_API_KEY=

# --- Optional: AWS Bedrock for the Strands agent (if the event hands out AWS credentials).
# If AWS_ACCESS_KEY_ID is set, the agent uses Bedrock; otherwise it uses ANTHROPIC_API_KEY.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=

# --- Optional: Google Calendar "Secret address in iCal format" (Minerva calendar). Treat as a secret.
MINERVA_ICAL_URL=

# --- Bright Data (brightdata.com → account settings → API token) ---
# The Bright Data MCP server reads API_TOKEN.
BRIGHTDATA_API_TOKEN=
API_TOKEN=${BRIGHTDATA_API_TOKEN}

# --- Strands agent model ---
STRANDS_MODEL_ID=claude-sonnet-5

# --- Tonight's guest list: folder holding the temporary luma_*.json export (kept out of the project on purpose)
GUESTS_DIR=
EVENT_ID=2026-09-21
EVENT_NAME=Battle of the Personal Brains
EVENT_HOSTS=Vasilije Markovic,Dave Nielsen
